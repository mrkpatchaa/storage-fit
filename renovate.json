{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:earlyMondays"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "prNotPendingHours": 96,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "All github-actions dependencies",
      "automerge": true
    },
    {
      "description": "Major versions of GitHub Actions wait for a review (no automerge)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
